# Copy to vpn.env. Only the VPN container (gluetun) reads this file, so the key isn't handed to the app.
# Proton VPN for qBittorrent. Paid plan, WireGuard config with NAT-PMP (port forwarding) on.
WIREGUARD_PRIVATE_KEY=
# Proton servers to use (comma-separated); nearby countries are faster.
SERVER_COUNTRIES=Austria,Italy,Hungary,Croatia,Switzerland,Germany
