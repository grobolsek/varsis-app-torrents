# Settings of the torrents plugin. They go in the same .env as the app's own settings:
#   cat ../varsis-app/.env.example .env.example > .env
# DATA_DIR (from the app's settings) also gets the folders downloads, prowlarr and qbittorrent.

PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=
QBIT_URL=http://qbittorrent:8081
QBIT_USER=admin
QBIT_PASS=
DOWNLOADS_DIR=/downloads

# The VPN key does not go here: see vpn.env.example.
